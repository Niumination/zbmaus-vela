[Unit]
Description=noVNC token gate proxy (6081 -> 6080)
After=network.target

[Service]
Type=simple
EnvironmentFile=$HOME/zb/omb-new/novnc-gate.env
ExecStart=$HOME/.local/node-v24.11.1-linux-x64/bin/node $HOME/zb/omb-new/novnc-gate.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
