[Unit]
Description=OMB relay bridge (sync webhook -> OMB bot reply) for zbmaus-humanoid
After=network.target

[Service]
Type=simple
Environment=BRIDGE_PORT=8801
Environment=BRIDGE_WAIT_MS=50000
Environment=INGRESS_BASE=http://127.0.0.1:8800
Environment=OMB_DATA_DIR=$HOME/.openmausbot-ombnew
EnvironmentFile=$HOME/zb/omb-new/relay-bridge.env
ExecStart=$HOME/.local/node-v24.11.1-linux-x64/bin/node $HOME/zb/omb-new/relay-bridge.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
